# Set the exact local NAS IP or hostname you will open in your browser.
NAS_HOST=nas.example.home
# Absolute host path to a selected photo/document folder. Do not mount the NAS root.
LIBRARY_PATH=/path/to/your/library
# Store this outside the source checkout so updates cannot replace app data.
CONFIG_PATH=/path/to/supergallery-config
# Read-only by default. Set rw only if you want uploads and file changes.
LIBRARY_MODE=ro
HTTPS_PORT=8843
